# PostgreSQL connection string (the only DB variable the app reads).
# Local:    postgresql://postgres:postgres@localhost:5432/academy_reg
# Supabase: use the "Transaction pooler" URI from the dashboard (aws-1-<region>.pooler.supabase.com:6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy_reg

# Session encryption (generate with: openssl rand -hex 32). Must be 32+ characters.
SESSION_SECRET=

# Serve mock data instead of DB reads. Only for Playwright e2e (playwright.config.ts sets it itself).
# Never enable alongside a real DATABASE_URL — writes always go to the real DB.
TEST_MODE=false

# Application
NEXT_PUBLIC_APP_NAME=이투스247이천기숙학원
TZ=Asia/Seoul
